---
import type { GetStaticPaths } from 'astro';
import type { PokemonListResponse } from '../../interfaces/pokemon-list.response';

import Title from '@components/shared/Title.astro';

import PokemonCard from '../../components/pokemons/PokemonCard.astro';
import MainLayout from '../../layouts/MainLayout.astro';

export const getStaticPaths = (async ({ paginate }) => {
  const resp = await fetch('https://pokeapi.co/api/v2/pokemon?limit=151');
  const { results } = (await resp.json()) as PokemonListResponse;

  return paginate(results, { pageSize: 20 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const title = 'Pokémon Static | Paginado';
---

<MainLayout title={title}>
  <Title>Listado Paginado</Title> 

  <section
    aria-label="Listado de Pokémons"
    class="grid grid-cols-1 sm:grid-cols-4 md:grid-cols-5 gap-4 mt-5"
  >
    {page.data.map(({ name, url }) => (
      <PokemonCard name={name} url={url} />
    ))}
  </section>

  <section class="flex mt-10 gap-2 items-center">
    <a
      class:list={['btn', { disabled: !page.url.prev }]}
      href={page.url.prev}
      aria-disabled={!page.url.prev}
      tabindex={page.url.prev ? undefined : -1}
    >
      Anteriores
    </a>

    <a
      class:list={['btn', { disabled: !page.url.next }]}
      href={page.url.next}
      aria-disabled={!page.url.next}
      tabindex={page.url.next ? undefined : -1}
    >
      Siguientes
    </a>

    <div class="flex flex-1"></div>
    <span class="text-xl font-bold">Página {page.currentPage}</span>
  </section>
</MainLayout>